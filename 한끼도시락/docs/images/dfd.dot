digraph DFD { rankdir=LR; graph [fontname="NanumGothic", bgcolor="white", pad="0.3"]; node [fontname="NanumGothic", fontsize=12]; edge [fontname="NanumGothic",fontsize=10]; employee [shape=box,label="직원"]; model [shape=box,label="Ollama 서버"]; p1 [shape=ellipse,label="1.0 주문 검증·변경"]; p2 [shape=ellipse,label="2.0 조회·집계"]; p3 [shape=ellipse,label="3.0 AI 요청 구성\n코드 판정 포함"]; p4 [shape=ellipse,label="4.0 응답 검사·표시"]; d1 [shape=record,label="D1 | 주문 CSV"]; d2 [shape=record,label="D2 | 서비스 규칙"]; d3 [shape=record,label="D3 | 세션 대화 이력"]; employee -> p1 [label="입력·상태변경 요청"]; d1 -> p1 [label="현재 주문"]; p1 -> d1 [label="검증된 변경"]; p1 -> employee [label="처리 결과·오류"]; employee -> p2 [label="기간·주문 선택"]; d1 -> p2 [label="주문 데이터"]; p2 -> employee [label="상세·집계"]; employee -> p3 [label="질문·선택 주문ID"]; d1 -> p3 [label="최소 주문 맥락"]; d2 -> p3 [label="규칙"]; d3 -> p3 [label="최근 이력"]; p3 -> model [label="규칙·판정·이력·질문"]; model -> p4 [label="모델 응답"]; p3 -> p4 [label="검증·연결 오류"]; p4 -> employee [label="답변·오류 안내"]; p4 -> d3 [label="정상 질문·답변"]; }