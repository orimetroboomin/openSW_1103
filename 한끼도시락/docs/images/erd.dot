digraph ER { graph [fontname="NanumGothic", bgcolor="white", pad="0.3"]; node [fontname="NanumGothic", fontsize=12]; edge [fontname="NanumGothic",fontsize=10]; node [shape=plain]; order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="9"><TR><TD><B>ORDER · 주문 (CSV 논리 모델)</B></TD></TR><TR><TD ALIGN="LEFT">order_id : string · 고유 식별자</TD></TR><TR><TD ALIGN="LEFT">group_name : string · 단체명</TD></TR><TR><TD ALIGN="LEFT">menu_name : string · 메뉴명</TD></TR><TR><TD ALIGN="LEFT">quantity : integer ≥ 1</TD></TR><TR><TD ALIGN="LEFT">pickup_date : YYYY-MM-DD</TD></TR><TR><TD ALIGN="LEFT">order_status : 접수 / 발주 완료 / 수령 완료 / 취소</TD></TR><TR><TD ALIGN="LEFT">created_at / updated_at : ISO datetime</TD></TR></TABLE>>]; note [shape=note,label="1주문 1메뉴 설계 가정\n관계형 DB 아님 · 관계 없음"]; order -> note [style=dashed,arrowhead=none]; }